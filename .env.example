# Copy to .env (repo root for docker compose, or backend/.env for local uvicorn).

# ENV=prod refuses to boot with the default JWT secret.
ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://splitfast:splitfast@localhost:5432/splitfast

# Razorpay test mode: Dashboard -> Account & Settings -> API Keys (Test Mode).
# Leave blank to run without online payments (cash settlements still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-host>/api/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed; paste the secret here.
RAZORPAY_WEBHOOK_SECRET=
